{
  "functions": {
    "api/check-reminders.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/check-reminders",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/check-reminders", "destination": "/api/check-reminders" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}